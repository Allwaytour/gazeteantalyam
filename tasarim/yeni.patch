diff --git a/assets/css/site.css b/assets/css/site.css
index c81303ed..98aab0fc 100644
--- a/assets/css/site.css
+++ b/assets/css/site.css
@@ -554,3 +554,54 @@ mark.doldur{background:#FFF1B8;color:#5A4500;padding:0 3px;border-radius:2px}
 }
 .kaldirilan h1{margin-bottom:14px}.kaldirma-notu p{margin:4px 0}
 .duz-liste{list-style:none;padding:0;margin:10px 0 24px}.duz-liste li{padding:10px 0;border-bottom:1px solid var(--cizgi,#E5E5E5)}.duz-liste small{display:block;color:var(--soluk,#666);margin-top:3px}
+
+/* ================= TASARIM DÜZELTMELERİ (27.11.2026) ================= */
+/* 1) Başlıklar hiçbir yerde kesilmez ("..." yok) */
+.hk-b,.hk-metin .hk-b,.yn-b,.yn-metin .yn-b,.slayt-b,.slayt-metin .slayt-b,.slayt-yan .slayt-b,.yazar-baslik,.one-metin-b,.manset-yazi-b{display:block;-webkit-line-clamp:none;line-clamp:none;overflow:visible}
+/* Görsel yüklenene kadar baskın renk (img üzerinde satır içi); kart zemini nötr */
+.hk-g{background:#EEF0F2}
+.hk-g img,.yn-foto img,.slayt img,.slayt-yan-g img,.kapak img{background-color:#E4E6E8}
+/* 6) Görselsiz kart: boş gri kutu yok; kategori etiketi, başlık, özet */
+.hk-metin .hk-m{padding:16px 18px 18px;gap:8px}
+.hk-metin .hk-o{display:block;-webkit-line-clamp:none;overflow:visible}
+/* 3) Reklam alanı: görselin oranında sabit yer (içerik kaymaz) */
+.reklam-alan{display:block;max-width:728px;margin:var(--ara) auto 0;text-align:center}
+.reklam-alan .vitrin-not{text-align:center;margin:0 0 5px;line-height:12px;height:12px}
+.reklam-alan .vitrin{display:block;width:100%;background:#E9EAEC;overflow:hidden}
+.reklam-alan .vitrin img{width:100%;height:100%;object-fit:cover}
+.ust-reklam .reklam-alan{max-width:970px;margin:0 auto}
+.icerik .reklam-alan{margin:24px auto 26px}
+/* 4) Etiketler yazının sonunda */
+.haber-etiketler-son{margin:24px 0 0;padding-top:16px;border-top:1px solid var(--cizgi);align-items:center}
+.haber-etiketler-son>span{font-size:13px;font-weight:900;text-transform:uppercase;letter-spacing:.04em;color:var(--soluk);margin-right:4px}
+@media (max-width:640px){
+  /* 1) Mobil: tek sütunlu liste — küçük görsel solda, başlık sağda */
+  .izgara-4,.izgara-3{grid-template-columns:minmax(0,1fr);gap:10px}
+  .hk-foto .hk-a{flex-direction:row;align-items:flex-start}
+  .hk-foto .hk-g{flex:none;width:128px;aspect-ratio:4/3;margin:12px 0 12px 12px}
+  .hk-foto .hk-m{padding:11px 12px 12px;gap:4px;min-width:0;align-self:center}
+  .hk-b,.hk-metin .hk-b{font-size:16px;line-height:1.3}
+  .hk-onemli.hk-metin .hk-b{font-size:17px}
+  .hk-metin{box-shadow:inset 3px 0 0 var(--turuncu)}
+  .hk-metin .hk-m{padding:12px 14px 13px;gap:5px}
+  .hk-metin .hk-o{font-size:14px;display:block}
+  .izgara-4 .hk-ust>span,.izgara-3 .hk-ust>span{display:inline}
+  .slayt-pencere{aspect-ratio:auto;height:auto}
+  .slayt-ic{align-items:stretch}
+  .slayt-foto>a{display:flex;flex-direction:column;height:100%}
+  .slayt-foto img{height:auto;aspect-ratio:4/3}
+  .slayt-foto .slayt-yazi{position:static;flex:1;padding:12px 16px 14px;background:var(--antrasit-koyu)}
+  .slayt-b{font-size:20px;text-shadow:none}
+  .yn-foto{aspect-ratio:auto}
+  .yn-foto>a{display:flex;flex-direction:row;align-items:center;gap:0;background:#fff;color:var(--metin)}
+  .yn-foto img{position:static;flex:none;width:128px;height:auto;aspect-ratio:4/3;margin:12px 0 12px 12px}
+  .yn-foto .yn-yazi{position:static;background:none;color:var(--metin);padding:11px 12px 12px}
+  .yn-b{font-size:16px}
+  .reklam-alan{margin-top:12px}
+  /* 2) WhatsApp düğmesi: küçük; aşağı kaydırırken gizlenir, yukarı kaydırınca görünür; sayfa sonunda içeriğin üstüne binmez */
+  .wa-yuzen{width:44px;height:44px;right:12px;bottom:12px;transition:transform .25s ease,opacity .25s ease}
+  .wa-yuzen svg{width:22px;height:22px}
+  .wa-yuzen.wa-gizli{transform:translateY(80px);opacity:0;pointer-events:none}
+  .alt-alt{padding-bottom:64px}
+}
+@media (prefers-reduced-motion:reduce){.wa-yuzen{transition:none}}
diff --git a/assets/js/site.js b/assets/js/site.js
index ba96001a..4f6be0e6 100644
--- a/assets/js/site.js
+++ b/assets/js/site.js
@@ -181,4 +181,22 @@
       }).catch(function () { durum.textContent = "Arama şu an yapılamadı."; });
     } else { durum.textContent = "Aramak istediğiniz kelimeyi yazın."; }
   }
+
+  // WhatsApp yüzen düğmesi (mobil): aşağı kaydırırken gizlenir, yukarı kaydırınca görünür; sayfa sonunda (alt bilgi) gizli kalır
+  var wa = $(".wa-yuzen");
+  if (wa) {
+    var sonY = window.scrollY, bekliyor = false;
+    window.addEventListener("scroll", function () {
+      if (bekliyor) return;
+      bekliyor = true;
+      requestAnimationFrame(function () {
+        var y = window.scrollY, fark = y - sonY;
+        var dip = y + window.innerHeight > document.documentElement.scrollHeight - 140;
+        if (dip || (fark > 6 && y > 120)) wa.classList.add("wa-gizli");
+        else if (fark < -6) wa.classList.remove("wa-gizli");
+        if (Math.abs(fark) > 6) sonY = y;
+        bekliyor = false;
+      });
+    }, { passive: true });
+  }
 })();
