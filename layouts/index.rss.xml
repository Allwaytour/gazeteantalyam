{{- $sayfalar := where site.RegularPages "Section" "in" (slice "haber" "kose") -}}
{{- $sayfalar = first 60 (sort $sayfalar "Date" "desc") -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ "/" | absURL }}</link>
    <description>{{ site.Params.aciklama }}</description>
    <language>tr-TR</language>
    <copyright>© {{ now.Year }} {{ site.Title }}</copyright>
    {{ with (index $sayfalar 0) }}<lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    <atom:link href="{{ "index.xml" | absURL }}" rel="self" type="application/rss+xml" />
    {{- range $sayfalar }}{{ $sayfa := . }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      {{ with .Params.kategoriler }}<category>{{ index . 0 }}</category>{{ end }}
      <description>{{ .Params.ozet | default (.Summary | plainify) | html }}</description>
      {{- with .Params.gorsel }}{{ if and (ne (partial "gorsel-tur.html" $sayfa) "kategori") (not (in . "/images/kategori/")) }}
      <media:content url="{{ partial "gorsel-url.html" (dict "u" (. | absURL) "w" 960) }}" medium="image" />{{ end }}{{ end }}
    </item>
    {{- end }}
  </channel>
</rss>
